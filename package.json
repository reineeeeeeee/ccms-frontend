{
  "name": "ccms-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "CCMS frontend: every screen of the system (public home, sign-in, accounts, offices, services, calendar). Calls the API gateway only.",
  "ccms": {
    "service": "frontend",
    "port": 3000
  },
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "next start -p 3000",
    "lint": "eslint .",
    "test": "node --test \"tests/unit/**/*.test.js\"",
    "ci": "npm run lint && npm test && npm run build"
  },
  "dependencies": {
    "ccms-shared": "file:./vendor/ccms-shared",
    "next": "^16.3.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "^16.3.0",
    "playwright": "^1.64.0",
    "postcss": "^8.5.0",
    "tailwindcss": "^4.1.0"
  }
}
